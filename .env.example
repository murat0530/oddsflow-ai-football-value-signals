# OddsFlow Telegram Bot — Environment Variables
# Kopyala: cp .env.example .env
# Sonra .env dosyasını düzenle

# @BotFather'dan aldığın token
BOT_TOKEN=your_bot_token_here

# Otomatik bildirim gönderilecek chat/grup/kanal ID'si
# Boş bırakırsan auto-notify devre dışı kalır
CHAT_ID=your_chat_id_here

# Canlı sinyal kontrol aralığı (saniye, varsayılan: 300 = 5 dakika)
POLL_INTERVAL=300
